# Copy to .env and adjust. These are public values (the anon key ships in
# every app build); never put the service role key here.
#
# Phone over USB:   http://127.0.0.1:54321 after `adb reverse tcp:54321 tcp:54321`
#                   (see docs/run-on-phone.md)
# Android emulator: http://10.0.2.2:54321 (the host machine)
# Phone over Wi-Fi: your computer's LAN IP, e.g. http://192.168.1.20:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# `npx supabase status` prints it; this is the fixed local-dev anon key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
